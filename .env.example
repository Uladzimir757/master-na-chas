# Copy to .env and fill in. See docs/mvp-task.md for what each of these is for.

DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

SESSION_SECRET=generate-a-random-string-here
ADMIN_SECRET=generate-a-different-random-string-here

# Telegram — one bot for the whole platform (@BotFather). Per-master chat_id
# is NOT here — it's in the DB, filled by the /telegram/webhook deep-link flow.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Web Push — generate a VAPID keypair once (see README), same pair for the
# whole platform, not per-master.
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
WEB_PUSH_ENABLED=false

# Twilio — see docs/mvp-task.md #6 for why Twilio (not a Polish SMS gateway) for now
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=MasterNaChas
SMS_ENABLED=false
